VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_PROFILE_BUCKET=profile-images
# Leave unset so Google login returns to the current site (Vercel or localhost).
# VITE_SUPABASE_AUTH_REDIRECT_URL=
VITE_SUPABASE_SKIP_EMAIL_CONFIRMATION=false
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-local-dev-only

# Free Walk AI Coach (server-only — never expose in VITE_*)
GEMINI_API_KEY=your-gemini-api-key

# live = Gemini Live coach (default), legacy = Web Speech + GaitFeedbackAdvisor
VITE_FREE_WALK_COACH_MODE=live